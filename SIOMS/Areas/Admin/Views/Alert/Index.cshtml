@model IEnumerable<SIOMS.Models.AlertLog>

@{
    ViewData["Title"] = "Alerts";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-exclamation-triangle"></i> Alert Management
        </h3>
        <div class="card-tools">
            <div class="btn-group">
                <a href="@Url.Action("Index", new { resolved = false })" class="btn btn-sm btn-warning">
                    <i class="fas fa-clock"></i> Active
                </a>
                <a href="@Url.Action("Index", new { resolved = true })" class="btn btn-sm btn-success">
                    <i class="fas fa-check"></i> Resolved
                </a>
                <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary">
                    <i class="fas fa-list"></i> All
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-check-circle text-success" style="font-size: 48px;"></i>
                <h4 class="mt-3">No alerts found</h4>
                <p class="text-muted">All systems are operating normally.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Message</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in Model)
                        {
                            <tr class="@(alert.IsResolved ? "table-success" : "table-warning")">
                                <td>
                                    <strong>@alert.Product?.Name</strong>
                                </td>
                                <td>@alert.Message</td>
                                <td>
                                    <span class="badge @(alert.AlertType == "LowStock" ? "badge-warning" : "badge-danger")">
                                        @alert.AlertType
                                    </span>
                                </td>
                                <td>@alert.AlertDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (alert.IsResolved)
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-check"></i> Resolved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">
                                            <i class="fas fa-clock"></i> Active
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        @if (!alert.IsResolved)
                                        {
                                            <button type="button" class="btn btn-success" 
                                                    data-toggle="modal" 
                                                    data-target="#resolveModal" 
                                                    data-id="@alert.Id"
                                                    data-product="@alert.Product?.Name">
                                                <i class="fas fa-check"></i> Resolve
                                            </button>
                                        }
                                        <button type="button" class="btn btn-danger" 
                                                data-toggle="modal" 
                                                data-target="#deleteModal" 
                                                data-id="@alert.Id"
                                                data-product="@alert.Product?.Name">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Resolve Modal -->
<div class="modal fade" id="resolveModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="Resolve" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Resolve Alert</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="resolveAlertId" value="" />
                    <p>Are you sure you want to resolve this alert for <strong id="resolveProductName"></strong>?</p>
                    <div class="form-group">
                        <label for="resolutionNotes">Resolution Notes</label>
                        <textarea name="resolutionNotes" class="form-control" rows="3" 
                                  placeholder="Enter resolution notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Resolve</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Delete Alert</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteAlertId" value="" />
                    <p>Are you sure you want to delete this alert for <strong id="deleteProductName"></strong>?</p>
                    <p class="text-danger"><i class="fas fa-exclamation-triangle"></i> This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Resolve Modal
            $('#resolveModal').on('show.bs.modal', function(event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var product = button.data('product');
                var modal = $(this);
                modal.find('#resolveAlertId').val(id);
                modal.find('#resolveProductName').text(product);
            });

            // Delete Modal
            $('#deleteModal').on('show.bs.modal', function(event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var product = button.data('product');
                var modal = $(this);
                modal.find('#deleteAlertId').val(id);
                modal.find('#deleteProductName').text(product);
            });
        });
    </script>
}