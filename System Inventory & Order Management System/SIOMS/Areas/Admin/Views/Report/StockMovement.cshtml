@model IEnumerable<SIOMS.Models.StockMovement>

@{
    ViewData["Title"] = "Stock Movement Report";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-exchange-alt"></i> Stock Movement Report
        </h3>
        <div class="card-tools">
            <a href="@Url.Action("StockMovement")" class="btn btn-sm btn-secondary">
                <i class="fas fa-undo"></i> Refresh
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="stockTable">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Type</th>
                        <th>Reference</th>
                        <th>Notes</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var movement in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@movement.Product?.Name</strong>
                                </td>
                                <td>
                                    <span class="@(movement.Quantity > 0 ? "text-success" : "text-danger")">
                                        @(movement.Quantity > 0 ? "+" : "")@movement.Quantity
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(movement.MovementType == "Purchase" ? "badge-success" : 
                                                       movement.MovementType == "Sale" ? "badge-danger" : 
                                                       movement.MovementType == "Return" ? "badge-info" : 
                                                       "badge-warning")">
                                        @movement.MovementType
                                    </span>
                                </td>
                                <td>@movement.ReferenceNumber</td>
                                <td>@movement.Notes</td>
                                <td>@movement.MovementDate.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-info-circle"></i> No stock movements found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable if needed
            if ($.fn.DataTable) {
                $('#stockTable').DataTable({
                    "order": [[5, "desc"]],
                    "pageLength": 50,
                    "language": {
                        "search": "Search:",
                        "lengthMenu": "Show _MENU_ entries",
                        "info": "Showing _START_ to _END_ of _TOTAL_ entries"
                    }
                });
            }
        });
    </script>
}