@model IEnumerable<SIOMS.Models.StockMovement>
@{
    ViewData["Title"] = "Stock Movements";
    ViewData["Subtitle"] = "Inventory stock history";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section HeaderButtons {
    <a asp-area="Admin" asp-controller="Report" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i> Back to Reports
    </a>
}

<div class="container-fluid py-4">
    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Stock Movement History</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Type</th>
                                <th>Reference</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var movement in Model)
                            {
                                <tr class="@(movement.Quantity > 0 ? "table-success" : "table-danger")">
                                    <td>@movement.MovementDate.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        @if (movement.Product != null)
                                        {
                                            <strong>@movement.Product.Name</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Unknown</span>
                                        }
                                    </td>
                                    <td>
                                        <strong class="@(movement.Quantity > 0 ? "text-success" : "text-danger")">
                                            @(movement.Quantity > 0 ? "+" : "")@movement.Quantity
                                        </strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@movement.MovementType</span>
                                    </td>
                                    <td>@movement.ReferenceNumber</td>
                                    <td>@movement.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-exchange-alt fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No stock movements found</h5>
                    <p class="text-muted">Stock movements will appear here when inventory changes.</p>
                </div>
            }
        </div>
    </div>
</div>
